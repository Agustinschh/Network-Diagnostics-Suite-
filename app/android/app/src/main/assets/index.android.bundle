onalizado')}</strong></div>\n  </div>\n  <div class="terminal-box">${n(i(t.sshDiagnostic.output))}</div>\n  `:''}\n\n  <h2>5. Evidencia Fotogr\xe1fica</h2>\n  <div class="photos-grid">\n    ${c}\n  </div>\n\n  <h2>6. Observaciones T\xe9cnicas</h2>\n  <div class="notes-box">\n    ${n(t.technicianNotes||'Sin observaciones adicionales registradas.')}\n  </div>\n\n  <div class="footer">\n    <div>\n      <p class="muted" style="margin:0;">Generado autom\xe1ticamente por NetDiag Mobile Suite.<br>Copia fiel de diagn\xf3stico en campo.</p>\n    </div>\n    <div class="signature-line">\n      ${n(t.technicianName)}<br>\n      <span class="muted" style="font-size:8pt; font-weight:normal;">Firma y aclaraci\xf3n del t\xe9cnico</span>\n    </div>\n  </div>\n\n</body>\n</html>\n  `.trim()},e.escapeHtml=n,e.truncateSshOutput=i},3510,[3365]);
