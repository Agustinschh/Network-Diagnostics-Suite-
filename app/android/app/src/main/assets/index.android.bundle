1px solid #E3E6EA;\n      border-radius: 4px;\n      padding: 10px;\n      font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;\n      font-size: 8.5pt;\n      white-space: pre-wrap;\n      word-break: break-all;\n      color: #1F2733;\n      max-height: 400px;\n    }\n    .data-table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 9pt;\n      margin-top: 8px;\n    }\n    .data-table th, .data-table td {\n      border: 1px solid #E3E6EA;\n      padding: 6px 8px;\n      text-align: left;\n    }\n    .data-table th {\n      background: #F6F7F9;\n      font-weight: 600;\n      color: #4A5361;\n    }\n    .badge {\n      display: inline-block;\n      padding: 2px 6px;\n      border-radius: 3px;\n      font-size: 7.5pt;\n      font-weight: 700;\n      text-transform: uppercase;\n    }\n    .badge-up {\n      background: #E8F6EE;\n      color: #15803D;\n    }\n    .badge-down {\n      background: #FDECEC;\n      color: #C62828;\n    }\n    .photos-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 12px;\n      margin-top: 10px;\n      page-break-inside: avoid;\n    }\n    .photo-card {\n      border: 1px solid #E3E6EA;\n      border-radius: 6px;\n      overflow: hidden;\n      background: #F6F7F9;\n    }\n    .photo-card img {\n      width: 100%;\n      height: 180px;\n      object-fit: cover;\n      display: block;\n    }\n    .photo-caption {\n      padding: 6px 10px;\n      font-size: 8.5pt;\n      font-weight: 600;\n      color: #4A5361;\n      text-align: center;\n      background: #FFFFFF;\n      border-top: 1px solid #E3E6EA;\n    }\n    .notes-box {\n      background: #F6F7F9;\n      border-left: 3px solid #2F5BEA;\n      padding: 10px;\n      font-size: 10pt;\n      margin-top: 8px;\n    }\n    .footer {\n      margin-top: 40px;\n      padding-top: 20px;\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-end;\n      page-break-in